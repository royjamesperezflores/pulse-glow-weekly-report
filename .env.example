# Copy to .env and fill in. .env is gitignored and never committed.
SHOPIFY_STORE=your-store-subdomain
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Email delivery. Gmail requires an App Password, not your account password:
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords
REPORT_FROM=you@gmail.com
REPORT_TO=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

# Preferred delivery: HTTPS, so blocked SMTP ports cannot stop the report.
# Free key at resend.com/api-keys
RESEND_API_KEY=
